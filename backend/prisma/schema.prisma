// ─────────────────────────────────────────────────────────────
// PARTNER BUSINESS DASHBOARD & MANAGEMENT SYSTEM
// ─────────────────────────────────────────────────────────────

model Partner {
  id           String    @id @default(uuid())
  partnerId    String    @unique // PHT0036, PHT0037, PHT0038...
  name         String
  email        String    @unique // Gmail ID
  phone        String    @unique // Mobile Number
  password     String    // Bcrypt hashed password for Partner Portal
  referralCode String    @unique // Unique Partner Referral Code (e.g., PHT0036)
  status       String    @default("ACTIVE") // ACTIVE | INACTIVE | SUSPENDED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  attributions   PartnerClientAttribution[]
  benefitLedgers PartnerBenefitLedger[]
  auditLogs      PartnerAuditLog[]
}

model PartnerClientAttribution {
  id           String    @id @default(uuid())
  partnerId    String
  partner      Partner   @relation(fields: [partnerId], references: [id])
  userId       String    @unique // Client User UUID
  user         User      @relation(fields: [userId], references: [id])
  studentId    String    // Client Student ID snapshot (e.g., HT0786)
  referralCode String    // Partner referral code used
  status       String    @default("PENDING") // PENDING | SUCCESS | INVALID
  createdAt    DateTime  @default(now())
  successAt    DateTime?

  benefits     PartnerBenefitLedger[]
}

model PartnerBenefitLedger {
  id              String                    @id @default(uuid())
  partnerId       String
  partner         Partner                   @relation(fields: [partnerId], references: [id])
  attributionId   String
  attribution     PartnerClientAttribution  @relation(fields: [attributionId], references: [id])
  clientStudentId String                    // Snapshot of Client Student ID (e.g., HT0786)
  paymentReqId    String?                   // Reference to approved PaymentRequest
  amount          Float                     @default(200) // Permanently fixed at ₹200
  payoutStatus    String                    @default("PENDING") // PENDING | PAID
  paidAt          DateTime?
  payoutReference String?                   // Transaction UTR / Ref recorded by Admin
  payoutAdminId   String?                   // Admin ID who processed payout
  createdAt       DateTime                  @default(now())
}

model PartnerAuditLog {
  id          String   @id @default(uuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id])
  adminId     String?  // Admin ID who performed the action (if admin-initiated)
  action      String   // PARTNER_CREATED | STATUS_CHANGED | BENEFIT_EARNED | BENEFIT_PAID | LOGIN_ATTEMPT
  oldValue    String?
  newValue    String?
  detail      String?
  timestamp   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// CLIENT-HOSTED EXECUTION AGENT MODELS (PHASE 1)
// ─────────────────────────────────────────────────────────────

model AgentKey {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash      String         @unique // SHA-256 hash of plaintext pairing key
  keyPrefix    String         // First 16 chars for display e.g. "ht_agent_live_ab..."
  label        String         @default("Execution Agent")
  status       String         @default("ACTIVE") // ACTIVE | REVOKED
  agentIp      String?
  lastSeenAt   DateTime?
  connectedAt  DateTime?
  revokedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  sessions     AgentSession[]

  @@index([userId, status])
}

model AgentSession {
  id             String    @id @default(uuid())
  agentKeyId     String
  agentKey       AgentKey  @relation(fields: [agentKeyId], references: [id], onDelete: Cascade)
  userId         String
  agentIp        String?
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  lastHeartbeatAt DateTime @default(now())
  latencyMs      Float?
  status         String    @default("CONNECTED") // CONNECTED | DISCONNECTED
  version        String?

  @@index([userId, status])
}

model AgentRiskSettings {
  id                           String   @id @default(uuid())
  userId                       String   @unique
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isLiveTradingEnabled         Boolean  @default(false)
  maxLots                      Int      @default(1)
  dailyProfitTargetEnabled     Boolean  @default(false)
  dailyProfitTarget            Float    @default(5000)
  dailyMaxLossEnabled          Boolean  @default(true)
  dailyMaxLoss                 Float    @default(10000)
  isPausedToday                Boolean  @default(false)
  pauseReason                  String?
  pausedDateStr                String?
  squareOffOnDailyLimitEnabled Boolean  @default(false)
  perTradeTargetEnabled        Boolean  @default(false)
  perTradeTarget               Float    @default(500)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model UserTradingVps {
  id                   String              @id @default(uuid())
  userId               String              @unique
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider             String              @default("DIGITALOCEAN") // DIGITALOCEAN | AWS_LIGHTSAIL | LINODE
  providerInstanceId   String?             // e.g. Droplet ID
  providerReservedIpId String?             // e.g. Reserved IP ID
  publicIp             String              @unique // Dedicated Static IPv4
  region               String              @default("blr1")
  planTier             String              @default("STARTER_1VCPU_2GB")

  status               String              @default("PROVISIONING") // PROVISIONING | BOOTSTRAPPING | ACTIVE_SIMULATION | ACTIVE_VERIFIED | PAUSED_MANUAL | GRACE_PERIOD | EXPIRED_PENDING_RELEASE | TERMINATED | ERROR
  isSimulationOnly     Boolean             @default(true) // STRICT: Starts in SIMULATION mode
  isLiveTradingAllowed Boolean             @default(false)
  ipWhitelistedAt      DateTime?

  billingCycleMonths   Int                 @default(1)
  monthlyAmount        Float               @default(799.00)
  purchasedAt          DateTime            @default(now())
  currentPeriodStart   DateTime            @default(now())
  currentPeriodEnd     DateTime
  gracePeriodEndsAt    DateTime?
  terminatedAt         DateTime?
  autoRenewEnabled     Boolean             @default(false)

  agentKeyId           String?
  auditLogs            VpsAuditLog[]
  billingInvoices      VpsBillingInvoice[]

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([userId, status])
  @@index([publicIp])
}

model VpsBillingInvoice {
  id                 String         @id @default(uuid())
  vpsId              String
  vps                UserTradingVps @relation(fields: [vpsId], references: [id], onDelete: Cascade)
  userId             String
  amount             Float
  currency           String         @default("INR")
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  paymentMethod      String         @default("WALLET") // WALLET | UPI | RAZORPAY_MANUAL
  paymentStatus      String         @default("PAID") // PAID | PENDING | FAILED | REFUNDED
  paymentRefId       String?
  invoiceNumber      String         @unique
  createdAt          DateTime       @default(now())

  @@index([userId, paymentStatus])
}

model VpsAuditLog {
  id        String         @id @default(uuid())
  vpsId     String
  vps       UserTradingVps @relation(fields: [vpsId], references: [id], onDelete: Cascade)
  userId    String
  action    String         // PROVISIONED | RENEWED | GRACE_ENTERED | IP_RETAINED | IP_RELEASED | REBOOTED | TERMINATED
  actor     String         @default("USER") // USER | SYSTEM | ADMIN | BILLING_CRON
  detail    String
  ipAddress String?
  timestamp DateTime       @default(now())

  @@index([vpsId, timestamp])
}

// ─────────────────────────────────────────────────────────────
// 🌐 CLIENT STATIC IP ASSIGNMENT & EXECUTION INFRASTRUCTURE
// ─────────────────────────────────────────────────────────────

model ClientStaticIpAssignment {
  id                     String                @id @default(uuid())
  userId                 String
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerConnectionId     String?
  brokerConnection       AlgoBrokerConnection? @relation(fields: [brokerConnectionId], references: [id], onDelete: SetNull)
  broker                 String                @default("ALL") // DHAN | ANGELONE | GOPOCKET | ALL

  // Connection / Transport Type
  connectionType         String                @default("DIRECT_IP") // DIRECT_IP | HTTP_PROXY | HTTPS_PROXY | SOCKS5

  // Public Egress IPv4 (Expected IP for broker whitelisting)
  ipAddress              String                // Dedicated Static IPv4 e.g. 103.212.121.207 or Expected Proxy Egress IP

  // Proxy Configuration (Credentials encrypted at rest with AES-256-GCM)
  proxyHost              String?               // e.g. 142.93.120.45 or proxy.provider.com
  proxyPort              Int?                  // e.g. 1080, 8080
  encryptedProxyUsername String?
  encryptedProxyPassword String?

  status                 String                @default("ASSIGNED") // UNASSIGNED | ASSIGNED | VERIFYING | VERIFIED | BLOCKED | RELEASED
  assignedAt             DateTime              @default(now())
  verifiedAt             DateTime?
  releasedAt             DateTime?
  lastObservedOutboundIp String?
  notes                  String?
  assignedByAdminId      String?

  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([userId, status])
  @@index([ipAddress])
  @@index([status])
  @@index([connectionType])
}


