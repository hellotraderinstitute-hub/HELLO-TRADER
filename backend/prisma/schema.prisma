model ContentCalendar {
  id             String    @id @default(uuid())
  date           DateTime
  platform       String    // INSTAGRAM | YOUTUBE | FACEBOOK | ALL
  contentTitle   String
  contentType    String    // Reel | Short | Video | Carousel | Image | Story
  status         String    @default("Draft") // Draft | Scheduled | Published | Cancelled
  priority       String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  ideaId         String?
  autoPublish    Boolean   @default(false)
  publishStatus  String?   // PENDING | SUCCESS | FAILED | CANCELLED
  publishError   String?
  platformPostId String?
  publishedAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

