  category    String   @default("TRADING_EDUCATION")
  avgViews    Float    @default(0)
  avgEngagement Float  @default(0)
  totalPosts  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContentHook {
  id          String   @id @default(uuid())
  textPattern String
  strength    String   @default("Average") // Strong | Average | Weak
  avgViews    Float    @default(0)
  avgShares   Float    @default(0)
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiRecommendation {
  id               String   @id @default(uuid())
  title            String
  category         String   @default("TOPIC_OPTIMIZATION")
  reason           String
  supportingMetric String
  confidence       String   @default("Medium") // High | Medium | Low
  suggestedAction  String
  targetPlatform   String?  @default("ALL")
  isApplied        Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model SocialStrategy {
  id                String   @id @default("GLOBAL")
  primaryObjective  String   @default("Trader Education & Terminal Awareness")
  targetAudience    String   @default("Active & Aspiring Indian Stock Traders (Ages 18-45)")
  contentPillars    String   @default("Trading Education, Trader Psychology, Trading Mistakes, Terminal / Technology, Algo Trading Education, Market Education, Behind The Scenes, Community / Student Education")
  preferredFormats  String   @default("Reel, Short, Carousel")
  postingFrequency  String   @default("1-2 Posts Per Day")
  ctaStrategy       String   @default("Educational Soft-CTA: Join Free Trial / Enroll Code")
  brandTone         String   @default("Professional, Empowering, Institutional & Transparent")
  topicsToAvoid     String   @default("Guaranteed Returns, Financial Advice, Get Rich Quick Claims, High Leverage Gambling")
  complianceNotes   String   @default("All AI-generated content must be manually reviewed before publishing. No guaranteed profit claims.")
  
  // Phase 2: Publishing Safety Gate (MUST default to FALSE)
