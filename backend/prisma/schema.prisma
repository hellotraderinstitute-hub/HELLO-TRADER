model SocialAccount {
  id                String    @id @default(uuid())
  platform          String    // INSTAGRAM | YOUTUBE | FACEBOOK | TIKTOK | LINKEDIN | TWITTER
  accountName       String
  accountHandle     String?
  avatarUrl         String?
  status            String    @default("DEMO") // DEMO | CONNECTED | DISCONNECTED | PENDING
  followerCount     Int       @default(0)
  postCount         Int       @default(0)
  
  // Phase 2: OAuth 2.0 Encrypted Credentials (AES-256 encrypted at rest. Passwords NEVER stored)
  accessToken       String?   // AES-256 encrypted
  refreshToken      String?   // AES-256 encrypted
  tokenExpiresAt    DateTime?
  externalAccountId String?
  scopes            String?
  
  // Sync Engine Metadata
  lastSyncedAt      DateTime?
  lastSyncStatus    String?   // SUCCESS | FAILED | RATE_LIMITED
  lastSyncError     String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  posts             SocialPost[]
}

model SocialPost {
  id            String   @id @default(uuid())
  accountId     String?
  account       SocialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  platform      String   // INSTAGRAM | YOUTUBE | FACEBOOK | ALL
  contentType   String   // Reel | Short | Video | Carousel | Image | Story
  title         String
  caption       String?
  postUrl       String?
  thumbnailUrl  String?
  durationSec   Int?
  publishedAt   DateTime @default(now())
  
  topic         String?
  hook          String?
  hookStrength  String?  // Strong | Average | Weak
  ctaText       String?
  postingHour   Int?     // 0-23
  postingDay    String?  // Monday, Tuesday, etc.
  isDemoData    Boolean  @default(true)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  metrics       SocialPostMetric[]
  variants      ContentVariant[]
}

model SocialPostMetric {
  id            String   @id @default(uuid())
  postId        String
  post          SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  views         Int      @default(0)
  reach         Int      @default(0)
  likes         Int      @default(0)
  comments      Int      @default(0)
  shares        Int      @default(0)
  saves         Int      @default(0)
  followersGained Int    @default(0)
  engagementRate Float   @default(0) // Percentage
  score         Float    @default(0) // 0-100 Performance Score
  retentionRate Float?   // Percentage
  recordedAt    DateTime @default(now())

  @@index([postId, recordedAt])
}

model ContentIdea {
  id                 String    @id @default(uuid())
  title              String
  topic              String
  hook               String?
  platform           String    @default("ALL") // INSTAGRAM | YOUTUBE | FACEBOOK | ALL
  contentType        String    @default("Reel") // Reel | Short | Video | Carousel | Image | Story
  targetAudience     String?
  cta                String?
  status             String    @default("Idea") // Idea | Draft | Ready | Awaiting Approval | Approved | Published | Analysing | Winner | Rejected
  priority           String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  aiScore            Float     @default(75)
  aiScript           String?   // Step-by-step video script outline
  complianceWarnings String?   // Filter audit snapshot
  approvedAt         DateTime?
  approvedBy         String?
  notes              String?
  isArchived         Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ContentVariant {
  id              String   @id @default(uuid())
  postId          String?
  post            SocialPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  ideaTitle       String
  variantLabel    String   // Variant A | Variant B | Variant C
  hookText        String
  views           Int      @default(0)
  retentionRate   Float    @default(0)
  engagementRate  Float    @default(0)
  shares          Int      @default(0)
  followersGained Int      @default(0)
  status          String   @default("NEEDS TESTING") // WINNER | NEEDS TESTING | UNDERPERFORMING
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
